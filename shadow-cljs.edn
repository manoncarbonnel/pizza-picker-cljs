;; shadow-cljs configuration
{:source-paths
 ["src/main"
  "src/test"]

 :dependencies
 [[reagent "2.0.1"]]

 :dev-http {9000 "public"}

 :builds
 {:app {:js-options {:entry-keys ["module" "browser" "main"]}
        :target :browser
        :output-dir "public/js"
        :asset-path "/js"
        :devtools {:watch-dir "public"}
        :main "pizza.picker"
        :modules {:main {:entries [pizza.picker]
                         :init-fn pizza.picker/main}}}}}
